{
  "name": "eu-uk-compliance-mcp",
  "version": "1.0.0",
  "description": "MCP Server for UK MHRA e-cigarette (ECIG/TRPR) and EU Flavourings (FIP) + Cosmetics/Fragrance (CosIng Annex II/III) regulatory compliance screening powered by Apify Actors.",
  "mcpName": "io.github.syin31437-collab/eu-uk-compliance-mcp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "eu-uk-compliance-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "compliance",
    "regulatory",
    "uk-mhra",
    "ecig",
    "trpr",
    "eu-cosing",
    "eu-fip",
    "flavourings",
    "fragrance-allergens",
    "apify"
  ],
  "author": "Shilin (Alex) Yin <syin31437@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/syin31437-collab/eu-uk-compliance-mcp.git"
  },
  "homepage": "https://github.com/syin31437-collab/eu-uk-compliance-mcp#readme",
  "bugs": {
    "url": "https://github.com/syin31437-collab/eu-uk-compliance-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
